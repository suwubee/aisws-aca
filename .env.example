# Copy this file to .env and adjust values as needed.
#
# Server
SERVER_HOST=0.0.0.0
SERVER_PORT=34007
# Demo mode (read-only UI/API)
DEMO_MODE=false
#
# Database
# Type: sqlite (default) or postgres
DATABASE_TYPE=sqlite
DATABASE_DSN=./data/aca.db
# PostgreSQL example:
# DATABASE_TYPE=postgres
# DATABASE_DSN=host=localhost user=aca password=secret dbname=aca port=5432 sslmode=disable
#
# Optional: Separate log database (PostgreSQL only, for high-volume logs)
LOG_DB_ENABLED=false
LOG_DB_TYPE=postgres
LOG_DB_DSN=host=localhost user=aca password=secret dbname=aca_logs port=5432 sslmode=disable
#
# Auth
AUTH_USERNAME=admin
AUTH_PASSWORD=admin123
JWT_SECRET=your-secret-key-change-in-production
#
# Terminal
TERMINAL_SHELL=/bin/bash
TERMINAL_DEFAULT_LOGIN_DIR=~/
#
# Logging
LOG_LEVEL=info
LOG_FILE=
#
# CORS (Cross-Origin Resource Sharing)
# Default: * (allow all origins). For production, set specific origins.
# Example: CORS_ALLOW_ORIGINS=https://example.com,https://app.example.com
CORS_ALLOW_ORIGINS=*
CORS_ALLOW_METHODS=GET,POST,PUT,DELETE,OPTIONS
CORS_ALLOW_HEADERS=Origin,Content-Type,Accept,Authorization
#
# Optional Redis
# REDIS_ADDR=127.0.0.1:6379
